# Copy this file to .env and fill in your Firebase project values.
# Firebase console > Project settings > General > Your apps > Web app.
# Leave empty to run in DEMO MODE (simulated data, nothing is sent anywhere).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Root path in the Realtime Database that your ESP32 writes to
VITE_DB_PATH=coldstorage
